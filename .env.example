# ===================================================
# MediaVault - Environment Configuration
# ===================================================
# Copy this file to .env:
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file or real API keys to GitHub!

# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# Used for the central GenAI Curator feature to provide personalized recommendations
GEMINI_API_KEY=your_gemini_api_key_here

# Port for the web server (default: 3000)
PORT=3000

# Optional custom database path (useful for AWS EBS/EFS mounts or Docker volumes)
# Defaults to ./data/media_vault.db if not specified
# DB_PATH=/app/data/media_vault.db

# Environment: 'development' (default) or 'production' (enforces secure HTTPS cookies)
NODE_ENV=development

# Reverse proxy trust level for deployments behind AWS App Runner, ALB, or Nginx
# Set to 1 when behind a single reverse proxy to prevent IP spoofing
# TRUST_PROXY=1

# Optional OMDb API Key for extended movie lookups (defaults to free tier)
# OMDB_API_KEY=your_omdb_api_key_here
